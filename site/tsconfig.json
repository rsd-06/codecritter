{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": { "@shared/*": ["../src/shared/*"] }
  },
  "include": ["src/**/*", "../src/renderer/overlay/**/*", "../src/shared/**/*"],
  "exclude": ["../src/**/*.test.ts"]
}
