{
  "name": "codecritter",
  "version": "0.1.0",
  "description": "Open-source pixel desktop companion (Stitch & Yoda) that reacts to your typing, your coding agents and your breaks",
  "keywords": [
    "desktop-pet",
    "pixel-art",
    "electron",
    "companion",
    "pomodoro",
    "claude-code",
    "codex",
    "ai-agents",
    "developer-tools",
    "overlay"
  ],
  "homepage": "https://github.com/rsd-06/codecritter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsd-06/codecritter.git"
  },
  "bugs": {
    "url": "https://github.com/rsd-06/codecritter/issues"
  },
  "author": "rsd-06",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "playground": "vite --config vite.playground.config.ts",
    "dist": "electron-vite build && electron-builder",
    "sprites:export": "esbuild tools/sprite-export.ts --bundle --platform=node --format=esm --alias:@shared=./src/shared --outfile=tools/out/.sprite-export.mjs --log-level=warning && node tools/out/.sprite-export.mjs",
    "tauri": "tauri",
    "gen:defaults": "node tools/gen-defaults.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "electron-store": "^8.2.0",
    "koffi": "^3.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uiohook-napi": "^1.5.5"
  },
  "optionalDependencies": {
    "get-windows": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
