{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeCritter",
  "version": "0.2.1",
  "identifier": "dev.codecritter.app",
  "build": {
    "beforeDevCommand": "npm run gen:defaults && vite --config vite.tauri.config.ts",
    "beforeBuildCommand": "npm run gen:defaults && vite build --config vite.tauri.config.ts",
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5175 http://localhost:5175"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "rsd-06",
    "copyright": "Copyright (c) rsd-06. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "Pixel desktop companion for developers",
    "longDescription": "Open-source pixel desktop companion (Stitch & Yoda) that reacts to your typing, your coding agents and your breaks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin/critter-hook.mjs": "bin/critter-hook.mjs"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "CodeCritter",
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rsd-06/codecritter/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyMEZBNDNCODI3ODExOUIKUldTYkVYaUNPNlFQd21ja2o1bE1IUlZwdDJGbi9jMGxHaXNFZ0VyNmRMckVjd1NteWhGZG1XOFQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
